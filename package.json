{
  "name": "oh-my-gauss",
  "version": "1.0.0",
  "description": "MCP server that gives Claude access to science knowledge — searches research papers, scrapes science news, and builds a local RAG knowledge base",
  "type": "module",
  "bin": {
    "oh-my-gauss": "dist/mcp/bin.js"
  },
  "main": "dist/mcp/bin.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); const f='dist/mcp/bin.js'; const c=fs.readFileSync(f,'utf8'); if(!c.startsWith('#!'))fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c); fs.chmodSync(f,0o755)\"",
    "prepublishOnly": "npm run build",
    "scrape": "tsx src/index.ts scrape",
    "papers": "tsx src/index.ts papers",
    "chat": "tsx src/index.ts chat",
    "mcp": "tsx src/mcp/stdio.ts",
    "mcp:http": "tsx src/mcp/server.ts",
    "cron:daily": "tsx src/cron/daily.ts"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "science",
    "research",
    "arxiv",
    "semantic-scholar",
    "rag",
    "knowledge-base",
    "tutor"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@mendable/firecrawl-js": "^1.19.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@xenova/transformers": "^2.17.2",
    "chromadb": "^1.9.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
